{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex flex-col gap-10">
        <div>
            <h3 class="text-4xl">{{ challenges|length }}</h3>
            {{ form(challengeFilterForm) }}
        </div>
        <div class="grid grid-cols-3 gap-3 mx-auto">
            {% for challenge in challenges %}
                <a href="{{ path('challenge_show', { id : challenge.id }) }}"
                   class="bg-white block max-w-sm p-6 border border-default rounded-base shadow-xs hover:bg-gray-100 rounded-lg space-y-3">
                    <div class="">
                        <h5 class="text-2xl font-semibold tracking-tight">{{ challenge.title }}</h5>
                        <h6 class="text-sm text-slate-600">{{ challenge.category.title }}</h6>
                    </div>
                    <p class="text-body">{{ challenge.description }}</p>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}
