{% extends 'base.html.twig' %}

{% block title %}Mes objectifs — FortyFit{% endblock %}

{% block body %}
    <div class="space-y-8">
        {# Header #}
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Mes objectifs</h1>
                <p class="mt-1 text-sm text-slate-400">{{ challenges|length }} objectif{{ challenges|length > 1 ? 's' : '' }} en cours</p>
            </div>
        </div>

        {# Filtres #}
        {% if challengeFilterForm is defined %}
            <div class="rounded-2xl bg-white/5 p-4 ring-1 ring-white/10">
                {{ form_start(challengeFilterForm, {'attr': {'class': 'flex flex-wrap items-center gap-4'}}) }}
                    <div class="flex-1 min-w-[200px]">
                        {{ form_widget(challengeFilterForm.category, {
                            'attr': {
                                'class': 'w-full rounded-xl bg-white/5 px-4 py-2.5 text-sm text-white ring-1 ring-white/10 focus:outline-none focus:ring-2 focus:ring-primary-500/50'
                            }
                        }) }}
                    </div>
                    <button type="submit" class="rounded-xl bg-white/10 px-4 py-2.5 text-sm font-medium hover:bg-white/15 transition-colors ring-1 ring-white/10">
                        Filtrer
                    </button>
                {{ form_end(challengeFilterForm) }}
            </div>
        {% endif %}

        {# Grid des challenges #}
        {% if challenges|length > 0 %}
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for challenge in challenges %}
                    <a href="{{ path('challenge_show', { id : challenge.id }) }}"
                       class="group rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 hover:bg-white/10 hover:ring-white/20 transition-all">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <h3 class="font-semibold text-white truncate">{{ challenge.title }}</h3>
                                <span class="inline-block mt-2 rounded-full bg-primary-500/15 px-3 py-1 text-xs font-medium text-primary-300 ring-1 ring-primary-500/20">
                                    {{ challenge.category.title }}
                                </span>
                            </div>
                            <div class="text-slate-500 group-hover:text-white transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </div>
                        </div>
                        {% if challenge.description %}
                            <p class="mt-3 text-sm text-slate-400 line-clamp-2">{{ challenge.description }}</p>
                        {% endif %}
                        {% if challenge.evaluations|length > 0 %}
                            <div class="mt-4 pt-4 border-t border-white/10">
                                <div class="flex items-center gap-2 text-xs text-slate-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                                    </svg>
                                    {{ challenge.evaluations|length }} évaluation{{ challenge.evaluations|length > 1 ? 's' : '' }}
                                </div>
                            </div>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="rounded-2xl bg-white/5 p-12 text-center ring-1 ring-white/10">
                <div class="mx-auto h-12 w-12 rounded-full bg-white/10 grid place-items-center mb-4">
                    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                </div>
                <h3 class="font-semibold text-white">Aucun objectif</h3>
                <p class="mt-2 text-sm text-slate-400">Commencez par créer votre premier objectif</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
