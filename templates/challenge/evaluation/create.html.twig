{% extends 'base.html.twig' %}

{% block title %}Nouvelle évaluation — {{ challenge.title }} — FortyFit{% endblock %}

{% block body %}
    <div class="space-y-8">
        {# Breadcrumb #}
        <nav class="flex items-center gap-2 text-sm text-slate-400">
            <a href="{{ path('challenge_index') }}" class="hover:text-white transition-colors">Mes objectifs</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <a href="{{ path('challenge_show', {'id': challenge.id}) }}" class="hover:text-white transition-colors truncate">{{ challenge.title }}</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="text-white">Nouvelle évaluation</span>
        </nav>

        {# Content #}
        <div class="mx-auto max-w-lg">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold tracking-tight">Nouvelle évaluation</h1>
                <p class="mt-2 text-sm text-slate-400">{{ challenge.title }}</p>
            </div>

            <div class="rounded-2xl bg-white/5 p-8 ring-1 ring-white/10">
                {% include 'challenge/evaluation/_form.html.twig' %}
            </div>
        </div>
    </div>
{% endblock %}
