{% extends 'base.html.twig' %}

{% block title %}Inscription — FortyFit{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold tracking-tight">Créer un compte</h1>
            <p class="mt-2 text-sm text-slate-400">Commencez votre parcours FortyFit</p>
        </div>

        <div class="rounded-2xl bg-white/5 p-8 ring-1 ring-white/10">
            {% if registrationForm.vars.errors|length > 0 %}
                <div class="mb-6 rounded-xl bg-red-500/10 px-4 py-3 text-sm text-red-300 ring-1 ring-red-500/20">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}
                <div>
                    <label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium text-slate-300 mb-2">Email</label>
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'w-full rounded-xl bg-white/5 px-4 py-3 text-sm text-white placeholder:text-slate-500 ring-1 ring-white/10 focus:outline-none focus:ring-2 focus:ring-primary-500/50 transition-shadow',
                            'placeholder': 'vous@exemple.com'
                        }
                    }) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div>
                    <label for="{{ registrationForm.plainPassword.vars.id }}" class="block text-sm font-medium text-slate-300 mb-2">Mot de passe</label>
                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'class': 'w-full rounded-xl bg-white/5 px-4 py-3 text-sm text-white placeholder:text-slate-500 ring-1 ring-white/10 focus:outline-none focus:ring-2 focus:ring-primary-500/50 transition-shadow',
                            'placeholder': '••••••••'
                        }
                    }) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

                <div class="flex items-start gap-3">
                    {{ form_widget(registrationForm.agreeTerms, {
                        'attr': {
                            'class': 'mt-1 h-4 w-4 rounded bg-white/5 border-white/20 text-primary-500 focus:ring-primary-500/50'
                        }
                    }) }}
                    <label for="{{ registrationForm.agreeTerms.vars.id }}" class="text-sm text-slate-400">
                        J'accepte les <a href="#" class="text-white hover:underline">conditions d'utilisation</a>
                    </label>
                </div>
                {{ form_errors(registrationForm.agreeTerms) }}

                <button type="submit" class="w-full rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-950 hover:bg-slate-100 transition-colors">
                    Créer mon compte
                </button>
            {{ form_end(registrationForm) }}

            <p class="mt-6 text-center text-sm text-slate-400">
                Déjà un compte ?
                <a href="{{ path('app_login') }}" class="text-white hover:underline">Se connecter</a>
            </p>
        </div>
    </div>
{% endblock %}
